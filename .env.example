# Copy to .env and fill in. .env is gitignored. Never commit real values.

# Which auth mode to use: oauth | service_account
# If unset, inferred: a key path below means service_account, otherwise oauth.
GSC_AUTH_MODE=oauth

# --- OAuth mode ---
# Path to the OAuth client file downloaded from Google Cloud Console.
# Keep it OUTSIDE this repo.
GSC_OAUTH_CLIENT_SECRET=/absolute/path/outside/repo/client_secret.json

# --- Service account mode ---
# Path to the service account JSON key. Keep it OUTSIDE this repo, chmod 600.
# GSC_SERVICE_ACCOUNT_KEY=/absolute/path/outside/repo/gsc-reader-key.json

# --- Optional safety rails ---
# Comma-separated allowlist. When set, the server refuses every other property.
# GSC_PROPERTY_ALLOWLIST=sc-domain:example.com,https://example.com/
# Where export_query writes CSV files. Default: ~/.gsc-mcp/exports
# GSC_EXPORT_DIR=/absolute/path/for/exports
# Drop rows whose query looks like personal data (emails, phones, long digits).
GSC_REDACT_PII=false
